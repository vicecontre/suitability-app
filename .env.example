# Copia este archivo a ".env" y completa con los datos de tu proyecto
# Supabase (Project Settings > API) para activar el guardado remoto de
# respuestas. Si se deja vacío, la app guarda en localStorage sin romperse.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Además de las variables de arriba, para usar Supabase hay que instalar el
# cliente una vez: npm install @supabase/supabase-js

# SQL para crear la tabla en Supabase (pegar en el SQL editor del proyecto):
#
# create table submissions (
#   id uuid primary key default gen_random_uuid(),
#   answers jsonb not null,
#   dimension_scores jsonb not null,
#   composite_score int not null,
#   initial_profile text not null,
#   final_profile text not null,
#   applied_filters jsonb not null,
#   consistency_flag boolean not null,
#   consistency_sd numeric,
#   bit_profile text,
#   created_at timestamptz not null default now()
# );
#
# alter table submissions enable row level security;
#
# create policy "Cualquiera puede insertar su propia respuesta"
#   on submissions for insert
#   to anon
#   with check (true);
#
# -- Sin política de SELECT para "anon": nadie puede leer las respuestas de
# -- otros desde el navegador. Para revisar los datos, usa el dashboard de
# -- Supabase (autenticado como owner del proyecto).
